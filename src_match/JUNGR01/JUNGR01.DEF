  RESGETMAXFADECOLORS  @3
  RESGETMAXTRANSCOLORS @4
  RESGETBUILDTYPE      @5
  RESSETSTRINGCOUNT    @6
  RESSETVARIABLECOUNT  @7
  RESSETNOTIFY         @8
